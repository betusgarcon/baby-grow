# baby-grow-mini/.gitignore

# Vercel 部署配置（含个人项目 ID）
.vercel/

# Trae 调试日志
.dbg/

# 微信小程序私有配置
**/project.private.config.json

# Dependencies
node_modules/
babycare/node_modules/
server/node_modules/

# Build output
babycare/dist/
babycare/.taro/
server/dist/

# Environment variables
.env
.env.local
.env.*.local
*.env

# IDE
.idea/
.vscode/
!.vscode/settings.json
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Taro / 小程序
babycare/.temp/
babycare/.swc/
babycare/coverage/

# Secrets（绝对不能提交）
*.pem
*.key
secrets/
