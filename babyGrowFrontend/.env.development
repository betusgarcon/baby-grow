# 配置文档参考 https://taro-docs.jd.com/docs/next/env-mode-config
# TARO_APP_ID="开发环境下的小程序appid"

# 后端地址。留空则整个前端走本地 mock，不发起真实请求。
# 微信开发者工具需勾选「不校验合法域名」才能访问 localhost。
#
# 本文件由 `pnpm dev:weapp`（--watch，mode=development）读取。
# 想用本地构建连线上后端，请用 `pnpm dev:weapp:online`（读 .env.production），
# 不要改这里——改了只影响本地模式，发布构建照旧走线上。
TARO_APP_API_BASE_URL="http://localhost:8080"

# 可选：字体文件根地址。留空时跟随 TARO_APP_API_BASE_URL。
# 本地是 http://localhost:8080，微信的 loadFontFace 要求 https，
# 所以开发者工具里字体通常不会加载，会回落到系统字体；发布构建不受影响。
# TARO_APP_FONT_BASE_URL=""
