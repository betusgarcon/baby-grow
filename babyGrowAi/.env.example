# AI 服务环境变量
# 复制此文件为 .env 并填入实际值

# 服务端口
AI_SERVICE_PORT=8001
LOG_LEVEL=INFO

# Ollama 地址（本地模型推理）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M
EMBEDDING_MODEL=bge-m3:latest
# 视觉模型：图片识别走这条（OLLAMA_MODEL 是纯文本模型，看不了图）
# 需先 `ollama pull qwen3-vl:8b`
VISION_MODEL=qwen3-vl:8b

# AI 行为参数
AI_TIMEOUT=60
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.1
AI_TOP_P=0.8
AI_NUM_CTX=1024

# 数据库：只连 AI 自己的向量库。
# 业务库 baby_grow 归 Java 后端独占，本服务不连（见 docs/backend-design.md §1.2）
PG_DSN=postgresql://postgres:postgres@localhost:5432/baby_grow_ai
REDIS_URL=redis://localhost:6379/0

# RAG 参数
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.5

# ── 模型后端选择 ─────────────────────────────────────────
# 全局开关，决定文本类任务（识别、食谱）走哪一侧：
#   gateway（默认）—— 云端大模型网关，用下面三个参数连接
#   local           —— 本机 Ollama（OLLAMA_BASE_URL），云端作为兜底
#
# 默认 gateway：本机不常开机、在外无法穿透，云端才是能一直依赖的一侧。
# 回家想用本机模型就把这里改成 local。
#
# embedding 不受本开关影响，始终走本机的 EMBEDDING_MODEL——
# 知识库向量是用 bge-m3 生成的，换模型会让检索静默失准。
AI_MODEL_SOURCE=gateway

# 云端网关连接参数（三个都填才算配好，缺一个就不启用该 provider）。
# DeepSeek 的 API 是 OpenAI 兼容的，直接按它的地址填即可：
#   EXTERNAL_MODEL_BASE_URL=https://api.deepseek.com
#   EXTERNAL_MODEL_NAME=deepseek-flash
EXTERNAL_MODEL_API_KEY=
EXTERNAL_MODEL_BASE_URL=
EXTERNAL_MODEL_NAME=

# 关掉推理模式（DeepSeek 的 thinking 参数）。**接了推理模型就必须置 true。**
#
# 实测（2026-10-15，deepseek-flash）：它每次调用先烧两百多个推理 token；抽取的
# 提示词较长，推理量会涨到把 AI_MAX_TOKENS 吃光，content 直接返回空，前端看到
# 整条抽取 503。关掉后同一个请求只花 36 个 token、零推理，既没有空响应，
# 也便宜约 5 倍、快约 30 倍（27s → 0.9s）。
#
# 这是 DeepSeek 的私有参数，原生 OpenAI 端点会以未知字段拒绝，所以默认 false。
EXTERNAL_MODEL_DISABLE_THINKING=false

# ── 文生图（心愿头图）─────────────────────────────────────
# 与上面那套文本路由完全独立：出图是另一家供应商、另一种接口形状，
# 而且 Ollama **不支持出图**，所以这一路没有本机退路，
# AI_MODEL_SOURCE 这个开关对它不起作用。
#
# 不填 API_KEY 时该能力整体关闭（/health 会显示 image=unconfigured）：
# 新建心愿照常成功，只是头图位置一直显示渐变占位。
#
# 硅基流动：https://cloud.siliconflow.cn  →  API 密钥
IMAGE_MODEL_API_KEY=
IMAGE_MODEL_BASE_URL=https://api.siliconflow.cn/v1
# 可换其它出图模型，例如 Qwen/Qwen-Image、black-forest-labs/FLUX.1-schnell
IMAGE_MODEL_NAME=Kwai-Kolors/Kolors
IMAGE_MODEL_SIZE=1024x1024
# 出图比对话慢得多，超时要给够；这也界定了 Java 侧那次调用的上界
IMAGE_MODEL_TIMEOUT=120
