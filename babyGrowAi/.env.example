# AI 服务环境变量
# 复制此文件为 .env 并填入实际值

# 服务端口
AI_SERVICE_PORT=8001
LOG_LEVEL=INFO

# Ollama 地址（本地模型推理）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M
EMBEDDING_MODEL=bge-m3:latest

# AI 行为参数
AI_TIMEOUT=60
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.1
AI_TOP_P=0.8
AI_NUM_CTX=1024

# 数据库
PG_DSN=postgresql://postgres:postgres@localhost:5432/baby_grow_ai
MYSQL_DSN=mysql+pymysql://babygrow:babygrow-dev@localhost:3306/baby_grow
REDIS_URL=redis://localhost:6379/0

# RAG 参数
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.5

# 外部模型兜底（预留，本期不实现）
EXTERNAL_MODEL_ENABLED=false
EXTERNAL_MODEL_API_KEY=
EXTERNAL_MODEL_BASE_URL=
EXTERNAL_MODEL_NAME=
