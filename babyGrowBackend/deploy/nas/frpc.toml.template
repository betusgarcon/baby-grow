# frpc.toml — FRP Client（部署在 NAS）
# 把下面的占位符替换后另存为 frpc.toml（deploy.sh / update-backend.sh 会自动做）。
#
# ⚠️ **本文件任何位置都不能出现连续两个半角花括号，注释里也不行。**
# snowdreamtech/frpc 会把这份配置当 Go text/template 渲染，空的 ｛｛｝｝ 会直接报错：
#   template: frp:2: missing value for command
# 结果 frpc 起不来、隧道不通、公网一律 502。2026-10-15 首次部署就栽在这里，
# 报错行号指的就是当时第 2 行注释里的那对括号。
# 渲染脚本在写回之前会检查残留，改动本文件后跑一次部署即可发现。
#
# 只建 baby-grow 自己的隧道。NAS 上还有兄弟项目 dailypawn 的 frpc 在跑，
# 它已承担了 SSH 隧道（remotePort 2222）——这里**不要**重复建，
# 两个 frpc 用同一个 proxy name / remotePort 会让 frps 报端口冲突。
#
# ECS frps 已设 proxyBindAddr=127.0.0.1，隧道端口只在 ECS 本机（Nginx）可达，
# 公网无法直连，这一点由 ECS 侧的配置保证。

serverAddr = "{{ECS_PUBLIC_IP}}"
serverPort = 7000

auth.method = "token"
auth.token = "{{FRP_TOKEN}}"

# ECS 未就绪时不退出容器，持续重连（飞牛 frpc 应用同款经验：退出了会闪退）
loginFailExit = false

log.to = "/var/log/frpc.log"
log.level = "info"
log.maxDays = 7

# baby-grow API → ECS 127.0.0.1:3003（仅 Nginx 反代可达）
[[proxies]]
name = "babygrow-api"
type = "tcp"
localIP = "127.0.0.1"
localPort = 3003
remotePort = 3003
