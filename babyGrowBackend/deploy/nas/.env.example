# NAS 生产环境变量模板。
#
# 复制为 .env 后填真实值。.env 已被 .gitignore 忽略，**绝不入库**
# （本仓库是公开仓库；兄弟项目 dailypawn 的同类文件已正确忽略，但其
#   deploy/ssh-config 漏了被跟踪，这里不要再犯）。
#
# {{}} 占位符由 deploy.sh 在渲染阶段替换；其余可按需直接改。

# ── 部署脚本自己读的变量 ─────────────────────────────────
# 这两个不会传给容器，只被 deploy.sh / update-backend.sh 用来渲染 frpc.toml。
# FRP_TOKEN 要与 ECS 上 frps.toml 的 auth.token 一致。
FRP_TOKEN={{FRP_TOKEN}}
ECS_PUBLIC_IP={{ECS_PUBLIC_IP}}

# ── 数据库 ───────────────────────────────────────────────
# Postgres 超级用户密码：AI 服务用它连 baby_grow_ai，也用于建库脚本
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
# 业务库账号密码：init-postgres 脚本建的 babygrow 账号，Java 后端用
DB_PASSWORD={{DB_PASSWORD}}

# ── 鉴权 ─────────────────────────────────────────────────
# 生产必须 false。true 会跳过微信校验、为固定 dev 用户签发 token——
# 等于任何人都能登进来。这个开关是本地开发的旁路，不是配置项。
APP_AUTH_DEV_MODE=false
# HS256 要求 ≥32 字节，用随机值；不要沿用仓库里的占位串
JWT_SECRET={{JWT_SECRET}}
JWT_TTL_HOURS=720
# 小程序凭据：微信公众平台 → 开发管理 → 开发设置
WX_APPID={{WX_APPID}}
WX_SECRET={{WX_SECRET}}

# ── 对外地址 ─────────────────────────────────────────────
# 拼图片的绝对 URL 用。小程序的 <Image src> 必须拿到绝对地址，
# 这个值要跟 nginx 的对外路径前缀一致。
MEDIA_PUBLIC_BASE=https://api.subetus.top/babygrow

# ── 演示数据 ─────────────────────────────────────────────
# 生产必须 false，否则第一个真实用户一打开就看到一整套假记录。
DEMO_DATA_ENABLED=false

# ── 模型后端 ─────────────────────────────────────────────
# gateway = 云端网关（DeepSeek）；local = 本机 Ollama，云端作为兜底。
# 默认 gateway：本机不常开机、在外无法穿透，云端才是能一直依赖的一侧。
#
# embedding 不受该开关影响，始终走本机的 EMBEDDING_MODEL——
# 知识库向量是用 bge-m3 生成的，换模型会让检索静默失准。
AI_MODEL_SOURCE=gateway

# DeepSeek（OpenAI 兼容，三个都填才启用）
EXTERNAL_MODEL_API_KEY={{DEEPSEEK_API_KEY}}
EXTERNAL_MODEL_BASE_URL=https://api.deepseek.com
EXTERNAL_MODEL_NAME=deepseek-flash

# 关掉推理模式。**用 deepseek-flash 这类推理模型时必须 true。**
# 实测：不关的话它每次调用先烧两百多个推理 token，把 AI_MAX_TOKENS 吃光，
# content 返回空 —— 抽取与食谱两条链路都会 503。关掉后快约 30 倍、便宜约 5 倍。
# 换成非推理模型或原生 OpenAI 端点时置 false（那是它的私有参数，别家会拒绝）。
EXTERNAL_MODEL_DISABLE_THINKING=true

# 本机 Ollama 地址。只有 AI_MODEL_SOURCE=local 时才会被用到。
# 注意：容器里不能用 localhost 指宿主机，要写宿主机在局域网中的地址。
OLLAMA_BASE_URL=http://{{OLLAMA_HOST_IP}}:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M
EMBEDDING_MODEL=bge-m3:latest
VISION_MODEL=qwen3-vl:8b

# ── 心愿头图（文生图）─────────────────────────────────────
# 与上面那套文本路由是**两条独立的路**：Ollama 不支持出图，所以这一路没有本机退路，
# AI_MODEL_SOURCE 对它不起作用。
#
# 两个开关都在这里：
#   IMAGE_MODEL_API_KEY  硅基流动的 Key —— 不填则出图能力整体关闭
#   WISH_COVER_ENABLED   后端是否在新建心愿后排队出图
#
# 默认关闭是必要的而不是偷懒：出图打的是外部付费接口，没配 key 就打开，
# 只会让每条新心愿静默变成 failed。关闭时头图位置显示渐变占位，心愿功能完全不受影响。
#
# 首次开启前先用真实 key 实测一次接口形状，见 deploy/README.md「心愿头图的图像生成」。
IMAGE_MODEL_API_KEY={{SILICONFLOW_API_KEY}}
IMAGE_MODEL_BASE_URL=https://api.siliconflow.cn/v1
IMAGE_MODEL_NAME=Kwai-Kolors/Kolors
IMAGE_MODEL_SIZE=1024x1024
IMAGE_MODEL_TIMEOUT=120
WISH_COVER_ENABLED=false

# ── RAG ──────────────────────────────────────────────────
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.5
