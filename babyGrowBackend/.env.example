# 复制为 .env 后按需填写。.env 已被 gitignore，绝不入库（本仓库是公开仓库）。
#
# 每一项都有可用的本地默认值：不填也能把主干跑起来。

# ── 数据库 ───────────────────────────────────────────────
# 业务库，与 AI 的向量库 baby_grow_ai 分开
DB_URL=jdbc:postgresql://localhost:5432/baby_grow
DB_USER=babygrow
DB_PASSWORD=babygrow-dev

# ── AI 服务 ──────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001

# ── 鉴权 ─────────────────────────────────────────────────
# true：跳过微信校验，直接为固定 dev 用户签发 token，没有微信凭据也能登录。
# 生产必须设为 false。
APP_AUTH_DEV_MODE=true

# HS256 要求至少 32 字节。生产必须换成随机值，不要沿用这个占位串。
JWT_SECRET=replace-me-with-a-random-32-byte-or-longer-secret
JWT_TTL_HOURS=720

# ── 微信小程序 ────────────────────────────────────────────
# 仅当 APP_AUTH_DEV_MODE=false 时才需要。凭据在微信公众平台申请。
WX_APPID=
WX_SECRET=

# ── 跨域 ─────────────────────────────────────────────────
# 小程序不走 CORS，这是给 Taro H5 预览调试用的
CORS_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
